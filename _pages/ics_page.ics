BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//ContraMontreal//iCal//EN
NAME:ContraMontreal
X-WR-CALNAME:ContraMontreal
{% if page.lang == "en" %}
DESCRIPTION:Upcoming dances for ContraMontreal https://www.contramontreal.org/
X-WR-CALDESC:Upcoming events for ContraMontreal https://www.contramontreal.org/
{% elsif page.lang == "fr" %}
DESCRIPTION:Danses à venir pour ContraMontreal https://www.contramontreal.org/accueil
X-WR-CALDESC:Danses à venir pour ContraMontreal https://www.contramontreal.org/accueil
{% endif %}
TIMEZONE-ID:America/Toronto
X-WR-TIMEZONE:America/Toronto
REFRESH-INTERVAL;VALUE=DURATION:PT24H
X-PUBLISHED-TTL:PT24H
{% if page.lang == "en" %}
URL:https://www.contramontreal.org/en/contramontreal.ics
{% elsif page.lang == "fr" %}
URL:https://www.contramontreal.org/fr/contramontreal.ics
{% endif %}
METHOD:PUBLISH

{% for dance in site.data.dances %}
{% assign current_date = 'today' | date: '%Y-%m-%d' %}
{% if dance.date and dance.date >= current_date and dance.start_time and dance.end_time %}

BEGIN:VEVENT
UID:{{ dance.date | date: "%Y%m%d" }}{% if dance.event_order_on_day %}{{ dance.event_order_on_day }}{% endif %}@contramontreal.org
DTSTAMP:{{ 'now' | date: "%Y%m%dT%H%M%S" }}
DTSTART;TZID=America/Toronto:{{ dance.date | append: "T" | append: dance.start_time | date: "%Y%m%dT%H%M%S" }}
DTEND;TZID=America/Toronto:{{ dance.date | append: "T" | append: dance.end_time | date: "%Y%m%dT%H%M%S" }}
{% if page.lang == "en" %}
{% if dance.cal_title.en %}
SUMMARY:ContraMontreal {{dance.cal_title.en}}
{% elsif dance.special.en %}
SUMMARY:ContraMontreal {{dance.special.en}}
{% else %}
SUMMARY:ContraMontreal Contra Dance
{% endif %}
{% elsif page.lang == "fr" %}
{% if dance.cal_title.fr %}
SUMMARY:ContraMontreal {{dance.cal_title.fr}}
{% elsif dance.special.fr %}
SUMMARY:ContraMontreal {{dance.special.fr}}
{% else %}
SUMMARY:ContraMontreal contredanse
{% endif %}
{% endif %}
{% if page.lang == "en" %}
{% if dance.location.en and dance.location.en != "" %}
LOCATION:{% if dance.location.en == "TBD" %}TBD{% else %}{{dance.location.en}}{% endif %}
{% endif %}
{% elsif page.lang == "fr" %}
{% if dance.location.fr and dance.location.fr != "" %}
LOCATION:{% if dance.location.fr == "TBD" %}À déterminer{% else %}{{dance.location.fr}}{% endif %}
{% endif %}
{% endif %}
{% assign hasCaller =
    dance.caller and dance.caller != "" and dance.caller != "TBD" %}
{% assign hasBand = dance.band and dance.band != "" and dance.band != "TBD" %}
{% if page.lang == "en" %}
{% if dance.cal_description.en %}
DESCRIPTION:{{dance.cal_description.en}} https://www.contramontreal.org/
{% else %}
DESCRIPTION:Contra dance
 {% if hasCaller %} called by {{dance.caller}}{% endif %}
 {% if hasBand %} with music by {{dance.band}}{% endif %}
 {% if dance.special.en %}\n{{dance.special.en}}{% endif %}
 {% if dance.text.en %}\n{{dance.text.en}}{% endif %}
 \nhttps://www.contramontreal.org/
{% endif %}
{% elsif page.lang == "fr" %}
{% if dance.cal_description.fr %}
DESCRIPTION:{{dance.cal_description.fr}} https://www.contramontreal.org/accueil
{% else %}
DESCRIPTION:Contredanse
 {% if hasCaller %} callée par {{dance.caller}}{% endif %}
 {% if hasBand %} avec musique par {{dance.band}}{% endif %}
 {% if dance.special.fr %}\n{{dance.special.fr}}{% endif %}
 {% if dance.text.fr %}\n{{dance.text.fr}}{% endif %}
 \nhttps://www.contramontreal.org/accueil
{% endif %}
{% endif %}
END:VEVENT

{% endif %}
{% endfor %}

END:VCALENDAR
